# ── Required ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_from_botfather
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_id

# ── Paths ─────────────────────────────────────────────────────────────────
KIRO_WORKDIR=/home/youruser
BRIDGE_DIR=/home/youruser/obsidian_control

# ── Backend ───────────────────────────────────────────────────────────────
AGENT_BACKEND=kiro
KIRO_CLI_PATH=/home/youruser/.local/bin/kiro-cli

# ── Tuning ────────────────────────────────────────────────────────────────
AGENT_TIMEOUT=180
RESPONSE_MODE=smart
MAX_FILE_SIZE=20971520

# ── Optional API backends ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

CLAUDE_CODE_PATH=claude
AIDER_PATH=aider
CUSTOM_CMD_TEMPLATE=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_FILE=/home/youruser/obsidian_control/bridge.log
