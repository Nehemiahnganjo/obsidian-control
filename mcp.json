{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/void"],
      "description": "Read and write files under /home/void"
    },
    "git": {
      "command": "uvx",
      "args": ["--with", "mcp==1.0.0", "mcp-server-git==0.6.2", "--repository", "/home/void/kiro-telegram-bridge"],
      "description": "Git operations: log, diff, commit, status"
    },
    "fetch": {
      "command": "uvx",
      "args": ["--with", "mcp==1.1.0", "mcp-server-fetch"],
      "description": "Fetch any URL, scrape web pages"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub API: issues, PRs, repos, code search"
    },
    "sqlite": {
      "command": "uvx",
      "args": ["--with", "mcp==1.0.0", "mcp-server-sqlite==0.6.2", "--db-path", "/home/void/obsidian_control/data.db"],
      "description": "Query SQLite databases"
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Web search via Brave — add BRAVE_API_KEY to .env to enable"
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "description": "Browser automation and screenshots"
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "Persistent key-value memory across sessions"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Structured step-by-step reasoning for complex problems"
    },
    "freecad": {
      "command": "/home/void/obsidian_control/freecad_mcp_launcher.sh",
      "env": {
        "FREECAD_MODE": "xmlrpc",
        "FREECAD_XMLRPC_PORT": "9875",
        "FREECAD_SOCKET_HOST": "localhost",
        "FREECAD_TIMEOUT_MS": "60000"
      },
      "description": "FreeCAD — create 3D CAD models, BIM architecture, house plans. Auto-starts FreeCAD headless bridge."
    }
  }
}
